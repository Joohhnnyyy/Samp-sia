# ==========================================
# Samp Environment Configuration
# ==========================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# Bright Data Credentials (Mandatory for production Scraper Studio runs)
# Promo code: wemakedevs (gives $25 free credits)
BRIGHTDATA_API_KEY=
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_ZONE=
BRIGHTDATA_SCRAPER_STUDIO_API_URL=https://api.brightdata.com/dca/v1

# LLM Configuration (Provider-agnostic)
# Supported providers: groq, openai, anthropic, local
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=gpt-oss-120b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database & Storage
DATABASE_URL=sqlite:///./neuroscrape.db
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./chroma_db

# NeuroAnchor Local Model
MODEL_PATH=./models/neuroanchor-v1-onnx
KARMA_MODEL_PATH=./models/karma-head.joblib
NEUROANCHOR_CONFIDENCE_THRESHOLD=0.72

# Ethics & Guardrails
ENFORCE_ROBOTS_TXT=true
BLOCK_PRIVATE_URLS=true
