# ==========================================
# NeuroScrape Git Ignore Rules
# Strictly prevents credential, environment, and binary leaks
# ==========================================

# 1. Environment & Secret Credentials (CRITICAL)
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.id_rsa
*.token

# 2. Local Databases & Vector Indexes
*.db
*.sqlite
*.sqlite3
neuroscrape.db
neuroscrape.db-journal
chroma_db/
chroma_db*/
*.chroma

# 3. Python Bytecode, Caches & Builds
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 4. Testing & Coverage Caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# 5. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 6. IDEs & Operating System Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 7. Logs & Temporary Files
*.log
logs/
tmp/
temp/
scratch/

# 8. Node.js & Frontend Caches
node_modules/
.vercel/
dist/
dist-ssr/
*.tsbuildinfo

